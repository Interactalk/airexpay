{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@airexpay/shared": ["packages/shared/src/index.ts"],
      "@airexpay/validation": ["packages/validation/src/index.ts"],
      "@airexpay/payment-core": ["packages/payment-core/src/index.ts"],
      "@airexpay/configuration": ["packages/configuration/src/index.ts"],
      "@airexpay/ui": ["packages/ui/src/index.ts"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["apps", "packages", "tests", "vitest.config.ts"]
}
