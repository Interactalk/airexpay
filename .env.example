# AirExpay Phase 1 — simulation only.
# These values are public placeholders, not credentials.
# Do not put real NOWPayments keys, Supabase keys, or IPN secrets in this file.
# The repository is public.

ENVIRONMENT=dev
ALLOWED_MODES=mock
NOWPAYMENTS_MODE_A_ENABLED=false

# Well-known in-memory demo tokens. They do not authenticate against any hosted service.
SIMULATION_API_KEY=ak_test_simulation_alpha
SIMULATION_IPN_SECRET=simulation-ipn-secret

# Leave empty. Live provider calls are disabled in code.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Not used in Phase 1. Do not point this at a hosted project from CI.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# memory (default) or postgres. postgres refuses any host that is not localhost
# and still needs an injected SQL client. This process does not open a connection.
STORAGE_BACKEND=memory
DATABASE_URL=

# Hosted checkout links returned by the API.
# Staging Worker: PUBLIC_CHECKOUT_BASE_URL=https://staging.airexpay.com
PUBLIC_CHECKOUT_BASE_URL=http://localhost:5173

# Web app API origin. Empty uses the Vite dev proxy (same origin).
# Staging build: VITE_API_BASE_URL=https://api-staging.airexpay.com
VITE_API_BASE_URL=
