# AirExpay Phase 1 — simulation only.
# These values are public placeholders, not credentials.
# Do not put real NOWPayments keys, Supabase keys, or IPN secrets in this file.
# The repository is public.

ENVIRONMENT=dev
ALLOWED_MODES=mock
NOWPAYMENTS_MODE_A_ENABLED=false

# Well-known in-memory demo tokens. They do not authenticate against any hosted service.
SIMULATION_API_KEY=ak_test_simulation_alpha
SIMULATION_IPN_SECRET=simulation-ipn-secret

# Leave empty. Live provider calls are disabled in code.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Not used in Phase 1. Do not point this at a hosted project from CI.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# memory (default, unit tests and the local dev server), postgres, or durable_object.
# postgres refuses any host that is not localhost and still needs an injected SQL client.
# durable_object uses the INVOICE_STORE binding. This process does not open a hosted database.
STORAGE_BACKEND=memory
DATABASE_URL=

# Only the exact string true turns livemode on. Simulation checkout stays off when it is true.
LIVEMODE=false

# Merchant webhook secrets are encrypted with AES-256-GCM.
# Leave these empty. Set them with `wrangler secret put`, not in this file.
# The value is base64 of 32 bytes (`openssl rand -base64 32`).
# Rotation: put the old key in WEBHOOK_SECRET_ENCRYPTION_KEY_PREVIOUS, the new key in
# WEBHOOK_SECRET_ENCRYPTION_KEY, re-save each webhook endpoint, then remove the previous key.
WEBHOOK_SECRET_ENCRYPTION_KEY=
WEBHOOK_SECRET_ENCRYPTION_KEY_PREVIOUS=

# Hosted checkout links returned by the API.
# Staging Worker: PUBLIC_CHECKOUT_BASE_URL=https://staging.airexpay.com
PUBLIC_CHECKOUT_BASE_URL=http://localhost:5173

# Web app API origin. Empty uses the Vite dev proxy (same origin).
# Staging build: VITE_API_BASE_URL=https://api-staging.airexpay.com
VITE_API_BASE_URL=
