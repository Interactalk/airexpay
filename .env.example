# AirExpay Phase 1 — simulation only.
# These values are public placeholders, not credentials.
# Do not put real NOWPayments keys, Supabase keys, or IPN secrets in this file.
# The repository is public.

ENVIRONMENT=dev
ALLOWED_MODES=mock
NOWPAYMENTS_MODE_A_ENABLED=false

# Well-known in-memory demo tokens. They do not authenticate against any hosted service.
SIMULATION_API_KEY=ak_test_simulation_alpha
SIMULATION_IPN_SECRET=simulation-ipn-secret

# Leave empty. Live provider calls are disabled in code.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Not used in Phase 1. Do not point this at a hosted project from CI.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
