{
  "name": "airexpay",
  "private": true,
  "version": "0.1.3",
  "description": "AirExpay — non-custodial crypto payment gateway software by AirexPay LLC. Phase 1 is simulation only.",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter @airexpay/api typecheck && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm --filter @airexpay/api build && pnpm --filter @airexpay/web build",
    "dev:web": "pnpm --filter @airexpay/web dev",
    "dev:api": "pnpm --filter @airexpay/api dev",
    "dev:api:local": "pnpm --filter @airexpay/api dev:local"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.56.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^3.2.4",
    "wrangler": "4.157.0"
  }
}
